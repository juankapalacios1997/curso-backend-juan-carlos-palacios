<div style="width: 100%;">
    <h1>Vinateria "La Gran Bodega"</h1>
    <h3>Registro de usuario</h3>
    <div>
        <form method="POST" action="/users">
            <label for="first_name">Nombre</label>
            <input name="first_name" type="text" id="first_name" placeholder="Nombre">
            <label for="last_name">Apellido</label>
            <input name="last_name" type="text" id="last_name" placeholder="Apellido">
            <label for="age">Edad</label>
            <input name="age" type="number" id="age" placeholder="Edad">
            <label for="email">E-mail</label>
            <input name="email" type="text" id="email" placeholder="E-mail">
            <label for="password">Contrasena</label>
            <input name="password" type="password" id="password" placeholder="Contrasena">
            <input type="submit" value="Acceder">
        </form>
    </div>
</div>