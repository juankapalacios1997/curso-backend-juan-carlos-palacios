<div style="width: 100%;">
    <h1>Bienvenido a La Vinateria "La Gran Bodega"</h1>
    <div style="display: flex;">
        <div style="width: 100%;">
            <h2>Nuestros productos:</h2>
            <ul id="listaProductos" style="list-style: none; display: grid; grid-template-columns: 1fr 1fr 1fr;">
                {{#each products}}
                    <li id="product-{{this.id}}" style="max-width: 22vw; margin: 12px; padding: 22px; background-color: rgb(165, 0, 0); color: white; border-radius: 24px;">
                        <div>
                            {{ this.title }}
                        </div>
                        <div>
                            {{ this.description }}
                        </div>
                        <div>
                            ${{ this.price }}
                        </div>
                        <div>
                            {{ this.stock }}
                        </div>
                    </li>
                {{/each}}
            </ul>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.7.2/socket.io.min.js"></script>
<script src="js/main.js"></script>